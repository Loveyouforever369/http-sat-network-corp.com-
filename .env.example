# ════════════════════════════════════════════════════════════════════════
#  SAT AGENT NETWORK — Environment Template
#  Copy to .env.local (gitignored) and fill in. NEVER commit real secrets.
#  "Needed when" tells you which milestone first requires each value.
# ════════════════════════════════════════════════════════════════════════

# ── Core app ────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Anthropic (agent brain + generator) ─ Needed: M2+ (run agents) ───────
# Rotate any key shared in plaintext. Place the fresh key here only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Supabase / Postgres ─ Needed: M1 ────────────────────────────────────
# DATABASE_URL is the pooled Postgres URL used by Drizzle (server-side).
DATABASE_URL=
# Direct (non-pooled) URL for migrations.
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (client-safe) key — newer projects: sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (server-only) key — newer projects: sb_secret_... (or service_role)
SUPABASE_SECRET_KEY=

# ── Credential Vault ─ Needed: M4 ───────────────────────────────────────
# 32-byte key, base64. Generate: openssl rand -base64 32
VAULT_ENCRYPTION_KEY=

# ── Gateway ⇄ Python Skill Runner ─ Needed: M3 ──────────────────────────
RUNNER_URL=http://localhost:8000
# Shared secret for gateway→runner auth. Generate: openssl rand -hex 32
RUNNER_SHARED_SECRET=

# ── MCP Gateway ─ Needed: M4 ────────────────────────────────────────────
GATEWAY_PUBLIC_URL=http://localhost:3000/api/mcp
# Bearer token Claude's MCP connector presents to our gateway.
GATEWAY_MCP_TOKEN=

# ── Safety defaults (agents that move money) ─ Needed: M3 ───────────────
# dry_run = simulate side-effects (default). live = real API writes.
AGENT_EXECUTION_MODE=dry_run
# Hard ceiling per agent run before human approval is required (USD).
DEFAULT_APPROVAL_THRESHOLD_USD=0
# Per-agent monthly spend cap (USD). 0 = no spend allowed until configured.
DEFAULT_SPEND_CAP_USD=0

# ── Render pipeline ─ Needed: M5 ────────────────────────────────────────
# Veo 3.1 (video) runs on the Gemini API. Optional until M5.
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-generate-preview
# Stills: Adobe Firefly is driven via MCP; optional direct creds below.
RENDER_IMAGE_PROVIDER=firefly

# ── Connectors ─ Needed: only to run a flagship agent LIVE ──────────────
# Stripe (test mode works immediately)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Shopify (custom app admin token, or per-shop OAuth)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ADMIN_TOKEN=
# Slack (OAuth app)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Salesforce (connected app, OAuth web server flow)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
# Zendesk (OAuth or API token)
ZENDESK_SUBDOMAIN=
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=
# Linear (personal API key or OAuth)
LINEAR_API_KEY=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# DocuSign (JWT / integration key)
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# OpenAI (used by agent STEPS that declare provider: OpenAI, e.g. sentiment)
OPENAI_API_KEY=
